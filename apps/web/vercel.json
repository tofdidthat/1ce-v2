{
  "git": {
    "deploymentEnabled": {
      "agent/1/T068-stems-vinculo": false,
      "agent/1/T061-meta-v2-independencia": false,
      "agent/1/T063-desktop-upload-v2": false,
      "agent/1/T065-beta-web": false
    }
  },
  "headers": [
    {
      "source": "/app/desktop-upload",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/instagram/data-deletion-status",
      "destination": "https://1ce-v2-production.up.railway.app/api/instagram/data-deletion-status"
    },
    {
      "source": "/api/instagram/auth",
      "destination": "https://1ce-v2-production.up.railway.app/api/instagram/meta-compliance"
    },
    {
      "source": "/api/publishing/tiktok-media",
      "destination": "https://1ce-v2-production.up.railway.app/api/publishing/tiktok-media"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
