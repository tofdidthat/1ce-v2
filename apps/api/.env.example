DATABASE_URL=postgresql://localhost:5432/onece_v2
WEB_ORIGIN=http://localhost:5173
PORT=3001
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Publishing uses the existing v2 Google OAuth client by default (HTTPS callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional dedicated YouTube app: configure ID/SECRET together, outside Git.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REDIRECT_URI=
# Optional independent encryption master; otherwise derived from v2 OAuth secret.
# PUBLISH_TOKEN_KEY=
# FFmpeg is installed by railpack.json; override only for local renderer tests.
# FFMPEG_PATH=ffmpeg
